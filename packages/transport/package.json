{
  "name": "@agentium/transport",
  "version": "4.7.0",
  "description": "HTTP and WebSocket transport layer for Agentium agents",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agentiumOS/agentium.git",
    "directory": "packages/transport"
  },
  "keywords": [
    "ai",
    "agents",
    "express",
    "socketio",
    "api",
    "transport"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config ../../tsdown.config.ts && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --pretty false && node ../../scripts/cjs-declarations.mjs",
    "dev": "tsdown --config ../../tsdown.config.ts --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.3.1",
    "typescript": "^5.6.0",
    "tsdown": "0.23.0"
  },
  "peerDependencies": {
    "@agentium/core": "^4.7.0",
    "@types/express": "^4.0.0 || ^5.0.0",
    "express": "^4.21.2 || ^5.2.1",
    "multer": "^2.3.0",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.0",
    "@a2a-js/sdk": "^1.3.0",
    "@modelcontextprotocol/server": "^2.3.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "socket.io": {
      "optional": true
    },
    "@types/express": {
      "optional": true
    },
    "multer": {
      "optional": true
    },
    "swagger-ui-express": {
      "optional": true
    },
    "@a2a-js/sdk": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    }
  },
  "homepage": "https://agentium.in",
  "bugs": {
    "url": "https://github.com/agentiumOS/agentium/issues"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  }
}
