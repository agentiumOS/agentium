{
  "name": "@agentium/observability",
  "version": "4.8.2",
  "description": "Tracing, metrics, and structured logging for Agentium agents",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agentiumOS/agentium.git",
    "directory": "packages/observability"
  },
  "keywords": [
    "ai",
    "agents",
    "observability",
    "tracing",
    "metrics",
    "langfuse",
    "opentelemetry"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config ../../tsdown.config.ts && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --pretty false && node ../../scripts/cjs-declarations.mjs",
    "dev": "tsdown --config ../../tsdown.config.ts --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@agentium/core": "^4.8.2"
  },
  "devDependencies": {
    "@types/node": "^25.3.1",
    "typescript": "^5.6.0",
    "tsdown": "0.23.0"
  },
  "homepage": "https://agentium.in",
  "bugs": {
    "url": "https://github.com/agentiumOS/agentium/issues"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  }
}
