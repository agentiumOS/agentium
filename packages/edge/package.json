{
  "name": "@agentium/edge",
  "version": "4.7.0",
  "description": "Edge deployment for Agentium — IoT toolkits (GPIO, sensors, camera, BLE), edge runtime, and Ollama helpers for Raspberry Pi",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agentiumOS/agentium.git",
    "directory": "packages/edge"
  },
  "keywords": [
    "ai",
    "agents",
    "edge",
    "iot",
    "raspberry-pi",
    "gpio",
    "ollama",
    "agentium"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config ../../tsdown.config.ts && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --pretty false && node ../../scripts/cjs-declarations.mjs",
    "dev": "tsdown --config ../../tsdown.config.ts --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.3.1",
    "typescript": "^5.6.0",
    "tsdown": "0.23.0"
  },
  "peerDependencies": {
    "@agentium/core": "^4.7.0",
    "node-libgpiod": ">=0.4.0",
    "i2c-bus": ">=5.0.0",
    "@stoprocent/noble": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "node-libgpiod": {
      "optional": true
    },
    "i2c-bus": {
      "optional": true
    },
    "@stoprocent/noble": {
      "optional": true
    }
  },
  "homepage": "https://agentium.in",
  "bugs": {
    "url": "https://github.com/agentiumOS/agentium/issues"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
