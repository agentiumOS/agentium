    },
    "gpt-tokenizer": {
      "optional": true
    },
    "neo4j-driver": {
      "optional": true
    },
    "cohere-ai": {
      "optional": true
    },
    "dockerode": {
      "optional": true
    },
    "@typesafe-ai/sdk": {
      "optional": true
    },
    "@modelcontextprotocol/client": {
      "optional": true
    },
    "@huggingface/transformers": {
